---
import images from '../generated/images.json';
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { src, ...attributes } = Astro.props;
const image = images[src as keyof typeof images];
const variants = image?.variants;
---
<img {...attributes} src={variants?.[0]?.src ?? src} srcset={variants && variants.length > 1 ? variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ') : undefined} decoding="async" />
