---
import type { App } from '../data/apps';
import { download } from '../data/apps';
import Icon from './Icon.astro';
import OptimizedImage from './OptimizedImage.astro';
interface Props { app: App; index: number }
const { app, index } = Astro.props;
const tags: Record<string, string[]> = {
  devpocket: ['6 种常用工具', '键盘优先', '本机转换'],
  macclean: ['开发缓存', '目录明细', '只读分析'],
  languageswitcher: ['拖入即识别', '单次启动', '保留系统语言'],
  quietlock: ['菜单栏常驻', '6 档息屏时间', '自动屏保'],
};
---
<article class={`app-card app-card-${app.slug}`} style={`--app-color:${app.color};--app-tint:${app.tint}`} data-reveal>
  <div class="app-card-body">
    <div class="card-topline"><span>0{index + 1}</span><span>{app.category}</span></div>
    <OptimizedImage src={app.icon} width="64" height="64" alt="" loading="lazy" />
    <h3><a href={`/${app.slug}/`}>{app.name}</a></h3>
    <p class="card-tagline">{app.tagline}。</p>
    <p class="app-card-description">{app.description}</p>
    <ul class="card-tags" aria-label="产品特点">{tags[app.slug].map(tag => <li>{tag}</li>)}</ul>
    <div class="card-links"><a class="button primary" href={`/${app.slug}/`}>认识 {app.name} <Icon name="arrow" size={16} /></a><a class="card-download" href={download(app)} aria-label={`下载 ${app.name} 最新 DMG`}><Icon name="download" size={17} /><span>下载</span></a></div>
  </div>
  <a class="card-preview" href={`/${app.slug}/`} aria-label={`查看 ${app.name} 详情`}>
    <span class="preview-caption"><span>{app.name.toUpperCase()} / FOR MAC</span><Icon name="diagonal" size={17} /></span>
    <OptimizedImage sizes="(max-width: 720px) calc(100vw - 72px), (max-width: 1000px) 52vw, 640px" src={app.screenshot} alt={app.screenshotAlt} width={app.screenshotWidth} height={app.screenshotHeight} loading="lazy" />
    <span class="preview-footnote"><span class="mini-dot"></span> {app.slug === 'quietlock' ? '浅色与深色，始终合拍' : '原生界面，为日常使用而做'}</span>
  </a>
</article>
