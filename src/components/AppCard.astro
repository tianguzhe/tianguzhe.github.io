---
import type { App } from '../data/apps';
import { download } from '../data/apps';
import Icon from './Icon.astro';
interface Props { app: App; index: number }
const { app, index } = Astro.props;
---
<article class={`app-card app-card-${app.slug}`} style={`--app-color:${app.color};--app-tint:${app.tint}`} data-reveal data-reveal-delay={index % 2 * 100} data-spotlight>
  <div class="app-card-body">
    <div class="card-topline"><span class="card-index">0{index + 1} / {app.category}</span><span class="platform-label"><Icon name="apple" size={13} /> macOS</span></div>
    <div class="app-card-heading"><img src={app.icon} width="72" height="72" alt="" loading="lazy" /><div><h3><a href={`/${app.slug}/`}>{app.name}</a></h3><p>{app.tagline}</p></div></div>
    <p class="app-card-description">{app.description}</p>
    <div class="card-links"><a class="text-link" href={`/${app.slug}/`}>了解应用 <Icon name="arrow" size={17} /></a><a class="card-download" href={download(app)} aria-label={`下载 ${app.name} 最新 DMG`}><Icon name="download" size={16} /> 下载</a></div>
  </div>
  <a class="card-preview" href={`/${app.slug}/`} aria-label={`查看 ${app.name} 详情`} tabindex="-1">
    <span class="preview-caption"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{app.name} for Mac</span><Icon name="diagonal" size={14} /></span>
    <img src={app.screenshot} alt={app.screenshotAlt} width={app.screenshotWidth} height={app.screenshotHeight} loading="lazy" />
    <span class="preview-explore">探索 {app.name} <Icon name="arrow" size={16} /></span>
  </a>
</article>
