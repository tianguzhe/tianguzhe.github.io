---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import MacCleanDetails from '../components/MacCleanDetails.astro';
import ProductStory from '../components/ProductStory.astro';
import { apps, download, repository } from '../data/apps';
export function getStaticPaths() { return apps.map((app) => ({ params: { app: app.slug }, props: { app } })); }
const { app } = Astro.props;
const others = apps.filter((other) => other.slug !== app.slug);
const schema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: app.name,
  applicationCategory: app.slug === 'devpocket' ? 'DeveloperApplication' : 'UtilitiesApplication',
  operatingSystem: 'macOS 14+', description: app.description,
  url: new URL(`/${app.slug}/`, Astro.site).href,
  image: new URL(app.screenshot, Astro.site).href,
  downloadUrl: download(app), author: { '@type': 'Person', name: 'tian', url: 'https://github.com/tianguzhe' },
};
---
<Layout title={`${app.name} · ${app.tagline} | tian`} description={app.description} image={`/images/social-${app.slug}.png`} imageAlt={`${app.name} · ${app.tagline}`}>
  <main id="main" tabindex="-1" class={`product-page product-${app.slug}`} style={`--app-color:${app.color};--app-tint:${app.tint}`}>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
    <div class="product-routebar container"><a class="back-link" href="/#apps"><Icon name="arrow" size={15} /> 所有应用</a><nav aria-label={`${app.name} 页内导航`}><a href="#preview">界面</a><a href="#features">功能</a><a href="#install">安装</a><a href="#faq">常见问题</a></nav></div>
    <section class="product-hero container">
      <div class="product-copy">
        <div class="product-identity"><OptimizedImage src={app.icon} width="56" height="56" alt="" /><div><span class="product-name">{app.name}</span><span class="product-category">{app.category} · 原生 macOS 应用</span></div></div>
        <h1>{app.headline[0]}<br /><span>{app.headline[1]}</span></h1>
        <p class="product-description">{app.description}</p>
        <div class="product-actions"><a class="button primary" href={download(app)}><Icon name="download" size={18} /> 下载 {app.name}</a><a class="button secondary" href={repository(app)} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} /> 查看源码</a></div>
        <p class="download-meta">macOS 14+ <span>·</span> Apple Silicon & Intel <span>·</span> DMG</p>
      </div>
      <div class="product-hero-note" aria-hidden="true"><span>DESIGNED FOR</span><strong>your everyday.</strong><span>轻巧 / 原生 / 本机运行</span></div>
    </section>
    <section id="preview" class="product-preview container" aria-label={`${app.name} 界面展示`}>
      <div class="product-visual">
        <div class="product-stage-label"><span><i></i>{app.name} / IN ACTION</span><span>原生界面</span></div>
        <a class="product-screenshot" href={app.screenshot} data-preview aria-label={`放大查看 ${app.name} 界面`}><OptimizedImage src={app.screenshot} alt={app.screenshotAlt} width={app.screenshotWidth} height={app.screenshotHeight} sizes="(max-width: 720px) calc(100vw - 64px), (max-width: 1000px) calc(100vw - 140px), 960px" fetchpriority="high" /><span class="screenshot-hint"><Icon name="search" size={16} /> 放大查看</span></a>
        <p class="visual-caption">{app.caption}</p>
      </div>
    </section>

    <section id="features" class="features-section container" aria-label={`${app.name} 核心功能`}><div class="features-grid">{app.features.map((feature, index) => <article data-reveal data-reveal-delay={index * 80}><span class="feature-icon"><Icon name={feature.icon} size={24} /></span><span class="feature-count">0{index + 1}</span><h2>{feature.title}</h2><p>{feature.text}</p></article>)}</div></section>

    {app.slug === 'macclean' ? <MacCleanDetails /> : <ProductStory slug={app.slug} />}

    <section class="steps-section container"><div class="section-heading" data-reveal><div><p class="eyebrow">GET INTO YOUR FLOW</p><h2>打开，就进入状态。</h2></div></div><ol class="steps-grid">{app.steps.map((step, index) => <li data-reveal data-reveal-delay={index * 80}><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></section>

    <section id="install" class="installation-section container"><div class="installation-panel" data-reveal><div><p class="eyebrow">A QUICK START</p><h2>装好，<br />就能开始。</h2><p>一个安装包，兼容 Apple Silicon 与 Intel。</p></div><div class="installation-content"><ol><li><span>1</span><p><a href={download(app)}>下载最新 DMG</a>，打开安装包。</p></li><li><span>2</span><p>将 <strong>{app.name}</strong> 拖入「应用程序」。</p></li><li><span>3</span><p>从「应用程序」打开，开始使用。</p></li></ol><div class="installation-note"><strong>首次打开提示</strong><p>目前安装包采用 ad-hoc 签名，尚未经过 Apple 公证。如被 macOS 拦截，请在「系统设置 → 隐私与安全性」中允许打开。</p></div><a class="text-link" href={`${repository(app)}/releases/latest`} target="_blank" rel="noopener noreferrer">版本说明与 SHA-256 校验 <Icon name="diagonal" size={14} /></a></div></div></section>

    <section id="faq" class="faq-section container"><div class="faq-heading"><p class="eyebrow">GOOD TO KNOW</p><h2>你可能还想知道。</h2><p>还有其他问题？<br /><a class="text-link" href={`${repository(app)}/issues`} target="_blank" rel="noopener noreferrer">到 GitHub 反馈 <Icon name="diagonal" size={14} /></a></p></div><div class="faq-list">{app.faqs.map((faq) => <details><summary>{faq.question}<span class="faq-plus" aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>

    <section class="download-section container"><div class="download-panel" data-reveal><OptimizedImage src={app.icon} alt="" width="80" height="80" loading="lazy" /><h2>从今天开始，<br />多一个顺手工具。</h2><p>原生体验，本机运行，为每天的使用而做。</p><a class="button primary" href={download(app)}><Icon name="download" size={18} /> 下载最新版本</a><span class="download-meta">macOS 14+ · Apple Silicon & Intel</span></div></section>

    <section class="more-apps container"><div class="more-apps-heading"><h2>还有这些小工具。</h2><a class="text-link" href="/#apps">查看全部 <Icon name="arrow" size={16} /></a></div><div class="more-apps-grid">{others.map((other) => <a href={`/${other.slug}/`}><OptimizedImage src={other.icon} width="48" height="48" alt="" loading="lazy" /><span><strong>{other.name}</strong><small>{other.tagline}</small></span><Icon name="arrow" size={18} /></a>)}</div></section>
  </main>
  <dialog class="image-dialog" aria-label={`${app.name} 界面预览`}>
    <div class="dialog-toolbar"><button type="button" class="dialog-zoom" data-preview-zoom aria-pressed="false">放大阅读</button><a class="dialog-original" href={app.screenshot} target="_blank" rel="noopener noreferrer">查看原图 <Icon name="diagonal" size={13} /></a><form method="dialog"><button class="dialog-close" aria-label="关闭界面预览">关闭 <span aria-hidden="true">×</span></button></form></div>
    <div class="dialog-image-frame" tabindex="0" role="region" aria-label="截图内容，放大后可滚动查看"><img data-dialog-image alt={app.screenshotAlt} width={app.screenshotWidth} height={app.screenshotHeight} /></div>
    <p>{app.caption}</p>
  </dialog>
</Layout>
