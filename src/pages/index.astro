---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import AppCard from '../components/AppCard.astro';
import { apps } from '../data/apps';
---
<Layout title="tian · 为 Mac 打造轻巧、实用的原生工具" description="发现 tian 制作的五款原生 Mac 应用：DevPocket 开发工具箱、MacClean 磁盘分析、LanguageSwitcher 应用语言切换、QuietLock 息屏与屏保控制、ProcScope 进程与端口观察。">
  <main id="main" tabindex="-1">
    <section class="studio-hero container">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> AN INDEPENDENT MAC APP STUDIO</p>
        <h1>小工具，<br />也值得<span class="serif-accent">用心。</span></h1>
        <p class="hero-description">为开发时的灵感，工作时的专注，<br />和每一个想让 Mac 更顺手的瞬间。</p>
        <div class="hero-actions"><a href="#apps" class="button primary">探索 {apps.length} 款应用 <Icon name="arrow" size={18} /></a><a href="#about" class="text-link">认识开发者 <Icon name="diagonal" size={16} /></a></div>
        <p class="hero-footnote"><Icon name="apple" size={16} /> 为 macOS 而生 <span>·</span> 由 tian 独立制作</p>
      </div>
      <div class="studio-shelf" aria-label="五款原生 Mac 应用">
        <div class="shelf-topline"><span>THE EVERYDAY COLLECTION</span><span>01 — {String(apps.length).padStart(2, '0')}</span></div>
        <div class="shelf-grid">
          {apps.map((app, index) => <a class={`shelf-app shelf-${index}`} href={`/${app.slug}/`} style={`--float-delay:${index * -1.6}s`}><span class="shelf-icon"><OptimizedImage src={app.icon} width="120" height="120" alt="" fetchpriority={index === 0 ? 'high' : 'auto'} /></span><strong>{app.name}</strong><span>{app.category}</span></a>)}
        </div>
        <div class="shelf-footer"><span class="shelf-stamp" aria-hidden="true">⌘</span><span>Made for your Mac.<br /><strong>Made for your everyday.</strong></span><span class="shelf-star" aria-hidden="true">✳</span></div>
      </div>
    </section>

    <div class="principles-strip container"><span><Icon name="command" size={18} /> 原生 macOS 体验</span><span><Icon name="shield" size={18} /> 数据在本机处理</span><span><Icon name="code" size={18} /> 源码公开可见</span><span><Icon name="apple" size={18} /> Apple Silicon & Intel</span></div>

    <section id="apps" class="apps-section container">
      <div class="section-heading" data-reveal><div><p class="eyebrow">01 / SELECTED APPS</p><h2>把日常小事，<br /><span class="serif-accent">认真做好。</span></h2></div><p class="section-aside">从一个具体的需要出发，<br />给每天的使用，多一点顺手。</p></div>
      <div class="apps-grid">{apps.map((app, index) => <AppCard app={app} index={index} />)}</div>
    </section>

    <section id="about" class="about-section container">
      <div class="about-panel">
        <div class="about-intro" data-reveal><p class="eyebrow">02 / THE PERSON BEHIND THE APPS</p><span class="maker-mark" aria-hidden="true">t.</span><h2>自己想用，<br />也希望你<span class="serif-accent">喜欢。</span></h2><p>你好，我是 tian。写代码，也做 Mac 工具。<br />这些应用始于日常遇到的小问题，<br />我希望它们安静、轻巧，打开就能派上用场。</p><a class="text-link" href="https://github.com/tianguzhe" target="_blank" rel="noopener noreferrer">在 GitHub 上找到我 <Icon name="diagonal" size={16} /></a></div>
        <div class="about-values">
          <div data-reveal><span>01</span><div><h3>熟悉，自然。</h3><p>用 SwiftUI 与系统能力构建，照顾快捷键，也照顾每一次点击。</p></div></div>
          <div data-reveal><span>02</span><div><h3>本机，就好。</h3><p>文本转换、磁盘分析与系统操作，都在你的 Mac 上完成，无需注册。</p></div></div>
          <div data-reveal><span>03</span><div><h3>打开，看见。</h3><p>源码、文档和反馈入口都在 GitHub。欢迎了解它们，也欢迎一起改进。</p></div></div>
        </div>
      </div>
    </section>
    <section class="home-outro container" data-reveal><span aria-hidden="true">✳</span><p>留一点空间，<br class="mobile-break" />给真正想做的事。</p><a href="#apps" class="text-link">找到你的顺手工具 <Icon name="arrow" size={17} /></a></section>
  </main>
</Layout>
